NODE_ENV=development
SERVICE_NAME=ntaps-service
LOG_LEVEL=info
HOST=0.0.0.0
API_PORT=3000
GRAPHQL_PORT=3001
GRPC_PORT=50051
SHUTDOWN_TIMEOUT_MS=30000
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false

# Infrastructure is opt-in so the template runs without external services.
REDIS_URL=
MONGODB_URL=
MONGODB_DATABASE=app
MYSQL_URL=
ELASTICSEARCH_URL=

SESSION_ENABLED=false
SESSION_SECRET=replace-with-at-least-32-characters
RATE_LIMIT_ENABLED=true
BULL_BOARD_ENABLED=false
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=replace-me
QUEUE_NAME=default
CRON_ENABLED=false
