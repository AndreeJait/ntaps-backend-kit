{
  "name": "@andreejait/template-be",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run format:check && tsc --noEmit && vitest run",
    "dev": "npm run dev:api",
    "dev:api": "tsx watch src/entrypoints/api.ts",
    "dev:gql": "tsx watch src/entrypoints/graphql.ts",
    "dev:grpc": "tsx watch src/entrypoints/grpc.ts",
    "dev:worker": "tsx watch src/entrypoints/worker.ts",
    "dev:cron": "tsx watch src/entrypoints/cron.ts",
    "start:api": "node dist/entrypoints/api.js",
    "start:gql": "node dist/entrypoints/graphql.js",
    "start:grpc": "node dist/entrypoints/grpc.js",
    "start:worker": "node dist/entrypoints/worker.js",
    "start:cron": "node dist/entrypoints/cron.js",
    "start": "npm run start:api",
    "generate": "ntaps generate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bull-board/api": "^6.15.0",
    "@bull-board/express": "^6.15.0",
    "@elastic/elasticsearch": "^9.1.0",
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.8.0",
    "bullmq": "^6.3.10",
    "connect-redis": "^10.0.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-basic-auth": "^1.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.18.2",
    "graphql": "^16.11.0",
    "graphql-yoga": "^5.16.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "mongodb": "^7.0.0",
    "mysql2": "^3.15.0",
    "node-cron": "^4.2.0",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "rate-limit-redis": "^4.3.0",
    "redis": "^5.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@andreejait/ntaps": "file:../ntaps",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/node": "^24.3.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
